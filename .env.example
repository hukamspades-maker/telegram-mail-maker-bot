# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Admin Telegram User IDs (Comma-separated integers, e.g. 12345678,87654321)
ADMIN_IDS=12345678

# Default Custom Domains (Comma-separated)
DEFAULT_DOMAINS=mycustomdomain.com,anotherdomain.io

# Cloudflare Inbound Webhook Listener Settings
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_SECRET=my-super-secret-webhook-key

# Optional: Catch-All IMAP Configuration (Fallback if not using Cloudflare Workers)
IMAP_ENABLED=false
IMAP_HOST=imap.mycustomdomain.com
IMAP_PORT=993
IMAP_USER=catchall@mycustomdomain.com
IMAP_PASSWORD=your_imap_password
IMAP_POLL_INTERVAL=15

# Database File Path
DATABASE_PATH=mail_bot.db

# Background Task Cleanup Interval (Minutes)
CLEANUP_INTERVAL_MINUTES=5
